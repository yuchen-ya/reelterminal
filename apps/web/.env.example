# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# OpenReel first-party cloud (templates, sharing, transcription, highlight AI).
# All values are optional; without them the built-in defaults apply.
# Base URL override for the cloud API. VITE_CLOUD_API_URL is still read as a
# lower-priority compatibility alias.
#VITE_OPENREEL_CLOUD_URL=
# Base URL override for the transcription (GPU) service.
#VITE_OPENREEL_TRANSCRIBE_URL=
# Set to `off` (exact value, case-insensitive) to build without any
# first-party cloud requests; every other value keeps the cloud enabled.
#VITE_OPENREEL_CLOUD=
