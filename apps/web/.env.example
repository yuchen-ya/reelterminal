# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# ReelTerminal first-party cloud (templates, sharing, transcription, highlight AI).
# All values are optional; without them the built-in defaults apply.
# Base URL override for the cloud API. The legacy VITE_OPENREEL_CLOUD_URL and
# the older VITE_CLOUD_API_URL are still read as lower-priority fallbacks.
#VITE_REELTERMINAL_CLOUD_URL=
# Base URL override for the transcription (GPU) service.
# Legacy name: VITE_OPENREEL_TRANSCRIBE_URL.
#VITE_REELTERMINAL_TRANSCRIBE_URL=
# Set to `off` (exact value, case-insensitive) to build without any
# first-party cloud requests; every other value keeps the cloud enabled.
# Legacy name: VITE_OPENREEL_CLOUD.
#VITE_REELTERMINAL_CLOUD=
