# Cloud services are unavailable by default. Local editing needs no backend.
VITE_REELTERMINAL_CLOUD=off
# Optional deployment-owned endpoints; no upstream service is supplied.
VITE_REELTERMINAL_CLOUD_URL=
VITE_REELTERMINAL_TRANSCRIBE_URL=
# Vidstab is disabled unless the deployment supplies licensed core binaries.
VITE_REELTERMINAL_VIDSTAB_MT_URL=
VITE_REELTERMINAL_VIDSTAB_ST_URL=

# Optional override for the public FFmpeg package CDN.
VITE_REELTERMINAL_FFMPEG_CORE_URL=
