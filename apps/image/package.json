{
  "name": "@reelterminal/image",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=openreel-image",
    "deploy:preview": "wrangler pages deploy dist --project-name=openreel-image --branch=preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const dir of ['dist', 'node_modules/.vite']) require('node:fs').rmSync(dir, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@reelterminal/image-core": "workspace:*",
    "@reelterminal/ui": "workspace:*",
    "lucide-react": "^0.555.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "4.115.0"
  }
}
