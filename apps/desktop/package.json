{
  "name": "@reelterminal/desktop",
  "private": true,
  "version": "1.2.4",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/yuchen-ya/reelterminal",
  "bin": {
    "reelctl": "dist/reelctl/index.js"
  },
  "author": {
    "name": "yuchen-ya and contributors"
  },
  "description": "ReelTerminal — the finishing editor for AI video",
  "scripts": {
    "build:main": "node scripts/prepare-aurora-native.mjs && tsup && node scripts/link-live-runtime-deps.mjs",
    "build:renderer": "cross-env REELTERMINAL_DESKTOP=1 pnpm --filter @reelterminal/web build",
    "build": "pnpm run build:renderer && pnpm run build:main && pnpm run build:user-guide && pnpm run build:licenses && node scripts/stamp-performance-build.mjs",
    "build:licenses": "pnpm --filter @reelterminal/desktop... --filter @reelterminal/web... licenses list --prod --json | node scripts/build-third-party-notices.mjs",
    "build:user-guide": "node scripts/build-user-guide.mjs",
    "predev": "pnpm run build:renderer",
    "dev": "tsup --watch --onSuccess \"electron .\"",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:licenses": "node --test scripts/build-third-party-notices.node-test.mjs scripts/prune-onnx-runtime.node-test.mjs",
    "test:installer": "node --test scripts/installer-data-policy.node-test.mjs scripts/legacy-upgrade-rehearsal.node-test.mjs",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:perf:counts": "tsc --noEmit --project e2e/performance/tsconfig.json && vitest run --config e2e/performance/vitest.counts.config.ts && node --test ../../scripts/performance/*.node-test.mjs",
    "test:perf:quick": "node ../../scripts/performance/run.mjs --suite quick",
    "test:perf:calibrate": "cross-env REELTERMINAL_PERFORMANCE_CALIBRATION=1 vitest run --config e2e/vitest.config.ts e2e/performance/probe-calibration.e2e.ts",
    "test:perf:benchmark": "node ../../scripts/performance/run.mjs --suite benchmark",
    "test:perf:soak": "node ../../scripts/performance/run.mjs --suite soak",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "prepare:aurora": "node scripts/prepare-aurora-native.mjs",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@reelterminal/agent-facade": "workspace:*",
    "@reelterminal/core": "workspace:*",
    "@reelterminal/runtime-chromium": "workspace:*",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.1",
    "mediabunny": "^1.55.4",
    "onnxruntime-node": "^1.30.0",
    "playwright-core": "^1.60.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
