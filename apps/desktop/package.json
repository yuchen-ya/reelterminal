{
  "name": "@reelterminal/desktop",
  "private": true,
  "version": "1.0.0-alpha.10",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/yuchen-ya/reelterminal",
  "bin": {
    "reelctl": "dist/reelctl/index.js",
    "reelterminal-live-mcp": "dist/live-mcp/legacy.js",
    "openreel-live-mcp": "dist/live-mcp/legacy.js"
  },
  "author": {
    "name": "yuchen-ya and contributors"
  },
  "description": "ReelTerminal — the finishing editor for AI video",
  "scripts": {
    "build:main": "node scripts/prepare-aurora-native.mjs && tsup && node scripts/link-live-runtime-deps.mjs",
    "build:renderer": "cross-env REELTERMINAL_DESKTOP=1 pnpm --filter @reelterminal/web build",
    "build": "pnpm run build:renderer && pnpm run build:main",
    "predev": "pnpm run build:renderer",
    "dev": "tsup --watch --onSuccess \"electron .\"",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "prepare:aurora": "node scripts/prepare-aurora-native.mjs",
    "pack": "pnpm run fetch:ffmpeg && pnpm run build && electron-builder --dir",
    "dist": "pnpm run fetch:ffmpeg && pnpm run build && electron-builder"
  },
  "dependencies": {
    "@esbuild/win32-x64": "0.27.7",
    "@reelterminal/agent-facade": "workspace:*",
    "@reelterminal/core": "workspace:*",
    "@reelterminal/runtime-chromium": "workspace:*",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.27.7",
    "mediabunny": "^1.25.3",
    "playwright-core": "^1.60.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
