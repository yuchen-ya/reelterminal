{
  "name": "reelterminal",
  "version": "0.1.1",
  "private": true,
  "description": "ReelTerminal — the agent-native finishing editor for AI video. Built on OpenReel; workspace packages are unified under @reelterminal/*.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @reelterminal/web dev",
    "build:wasm": "pnpm --filter @reelterminal/core build:wasm",
    "build": "pnpm build:wasm && pnpm --filter @reelterminal/web build",
    "preview": "pnpm --filter @reelterminal/web preview",
    "deploy": "pnpm build && pnpm --filter @reelterminal/web deploy",
    "deploy:preview": "pnpm build && pnpm --filter @reelterminal/web deploy:preview",
    "test": "pnpm -r test:run && pnpm test:adapters",
    "test:adapters": "node --test scripts/conversation-adapter/*.test.mjs",
    "test:watch": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "keywords": [
    "video-editor",
    "audio-editor",
    "browser-based",
    "webcodecs",
    "webgpu",
    "react",
    "typescript",
    "open-source",
    "video-editing",
    "timeline",
    "color-grading",
    "export"
  ],
  "author": "yuchen-ya and contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuchen-ya/reelterminal.git"
  },
  "bugs": {
    "url": "https://github.com/yuchen-ya/reelterminal/issues"
  },
  "homepage": "https://github.com/yuchen-ya/reelterminal#readme",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/core-mt": "0.12.6",
    "mediabunny": "^1.25.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.1"
  }
}
