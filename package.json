{
  "name": "agent-video-engine-lab",
  "version": "0.1.1",
  "private": true,
  "description": "Agent Video Engine Lab: agent-first video-editing engine experiments (agent facade + Chromium render/export runtime) over the OpenReel codebase. Private monorepo root; packages keep their @openreel/* names.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @openreel/web dev",
    "build:wasm": "pnpm --filter @openreel/core build:wasm",
    "build": "pnpm build:wasm && pnpm --filter @openreel/web build",
    "preview": "pnpm --filter @openreel/web preview",
    "deploy": "pnpm build && pnpm --filter @openreel/web deploy",
    "deploy:preview": "pnpm build && pnpm --filter @openreel/web deploy:preview",
    "test": "pnpm -r test:run",
    "test:watch": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "keywords": [
    "video-editor",
    "audio-editor",
    "browser-based",
    "webcodecs",
    "webgpu",
    "react",
    "typescript",
    "open-source",
    "video-editing",
    "timeline",
    "color-grading",
    "export"
  ],
  "author": "Augustus Otu and Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuchen-ya/agent-video-engine-lab.git"
  },
  "bugs": {
    "url": "https://github.com/yuchen-ya/agent-video-engine-lab/issues"
  },
  "homepage": "https://github.com/yuchen-ya/agent-video-engine-lab#readme",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/core-mt": "0.12.6",
    "mediabunny": "^1.25.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.1"
  }
}
