{
  "name": "@reelterminal/agent-transport",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "ADR 0003 slice 2b/2c: the reelterminal-agent CLI — MCP stdio server (serve), executable workflow runner (run), and environment doctor. One process == one AgentFacadeSession.",
  "bin": {
    "reelterminal-agent": "dist/cli.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": {
      "import": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "node scripts/unlink-runtime-deps.mjs && tsup && node scripts/link-runtime-deps.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@reelterminal/agent-facade": "workspace:*",
    "@reelterminal/runtime-chromium": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "ajv": "8.20.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
