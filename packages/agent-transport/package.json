{
  "name": "@reelterminal/agent-transport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ADR 0003 slice 2b/2c: the reelterminal-agent CLI (legacy command name: agent-video) — MCP stdio server (serve), executable workflow runner (run), and environment doctor. One process == one AgentFacadeSession.",
  "bin": {
    "reelterminal-agent": "dist/cli.js",
    "agent-video": "dist/cli.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": {
      "import": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "node scripts/unlink-runtime-deps.mjs && tsup && node scripts/link-runtime-deps.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@reelterminal/agent-facade": "workspace:*",
    "@reelterminal/runtime-chromium": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "8.17.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
