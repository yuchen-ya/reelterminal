{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@reelterminal/core": ["../core/src/index.ts"],
      "@reelterminal/core/*": ["../core/src/*"],
      "@reelterminal/agent-facade": ["../agent-facade/src/index.ts"],
      "@reelterminal/agent-facade/*": ["../agent-facade/src/*"],
      "@reelterminal/runtime-chromium": ["../runtime-chromium/src/index.ts"],
      "@reelterminal/runtime-chromium/*": ["../runtime-chromium/src/*"],
      "@reelterminal/agent-transport": ["./src/index.ts"],
      "@reelterminal/agent-transport/*": ["./src/*"]
    }
  },
  "include": ["src", "test", "scripts", "tsup.config.ts", "vitest.config.ts"]
}
