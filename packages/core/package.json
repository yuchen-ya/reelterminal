{
  "name": "@reelterminal/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./motion/shaders": {
      "import": "./src/motion/shaders/index.ts",
      "types": "./src/motion/shaders/index.ts"
    },
    "./*": {
      "import": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:wasm": "npm run build:wasm:fft && npm run build:wasm:wav && npm run build:wasm:beat",
    "build:wasm:fft": "asc src/wasm/fft/assembly/index.ts -o src/wasm/fft/build/fft.wasm --optimize --runtime stub",
    "build:wasm:wav": "asc src/wasm/wav/assembly/index.ts -o src/wasm/wav/build/wav.wasm --optimize --runtime stub",
    "build:wasm:beat": "asc src/wasm/beat-detection/assembly/index.ts -o src/wasm/beat-detection/build/beat.wasm --optimize --runtime stub"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/three": "^0.182.0",
    "assemblyscript": "^0.27.37",
    "fast-check": "^3.23.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@paper-design/shaders": "0.0.72",
    "immer": "^11.1.18",
    "mediabunny": "^1.55.4",
    "polygon-clipping": "0.15.7",
    "three": "^0.182.0",
    "uuid": "^13.0.2"
  }
}
