{
  "name": "@reelterminal/creation-bindings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node addon / WASM bindings for @reelterminal/creation-core with a CPU fallback to @reelterminal/core/creation.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@reelterminal/core": "workspace:*"
  }
}
